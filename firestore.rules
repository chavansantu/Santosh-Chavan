rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Disallow global access by default (Zero Insecure Defaults)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Coordinate Boundary Validation
    function isValidLocation(data) {
      return !('location' in data) || data.location == null || (
        data.location.latitude is number &&
        data.location.latitude >= -90.0 && data.location.latitude <= 90.0 &&
        data.location.longitude is number &&
        data.location.longitude >= -180.0 && data.location.longitude <= 180.0
      );
    }

    // Helper: Admin Role Verification via Custom Claims or configured admin emails list
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        request.auth.token.email in [
          'chavansantu1899@gmail.com',
          'admin@example.com',
          'security@example.com',
          'cloud-architect@example.com',
          'audit-team@example.com'
        ]
      );
    }

    // User data isolation: strictly bound to authenticated user ID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /interactions/{interactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /entries/{entryId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && 
                                request.auth.uid == userId && 
                                isValidLocation(request.resource.data);
      }
    }

    // Admin & System Telemetry: Restricted strictly to authenticated Admins
    // No private user journal entries are stored here, only aggregated metrics
    match /system_metrics/{metricDoc} {
      allow read, write: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}

