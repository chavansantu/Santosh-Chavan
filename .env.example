# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Global Google Maps Platform API key.
# Used server-side for address geocoding, reverse geocoding, and map previews.
# Zero client-side keys: kept securely on server to prevent browser token extraction.
GOOGLE_MAPS_API_KEY=""

# NOTIFICATION_WEBHOOK_URL: Global Notification Webhook URL (Slack, Discord, or HTTPS endpoint).
# Automatically delivers milestone alerts and critical reflection triggers with SSRF protection.
NOTIFICATION_WEBHOOK_URL=""

# ADMIN_EMAILS: Comma-separated list of multiple admin email addresses with elevated RBAC access.
# Supports multiple administrators across organizational domains.
ADMIN_EMAILS="chavansantu1899@gmail.com,admin@example.com,security@example.com"
